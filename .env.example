# ============================================================================
# 環境変数テンプレート (.env.example)
# ----------------------------------------------------------------------------
# このファイルをコピーして .env.local を作成し、各値を埋めること:
#     cp .env.example .env.local
# 本番(Vercel)では Project Settings > Environment Variables に同じキーを登録する。
# 値はプレースホルダ。実際のシークレットは絶対にコミットしないこと。
# ============================================================================

# --- Resend (メール送信) -----------------------------------------------------
# Resend のAPIキー。https://resend.com/api-keys で発行。
RESEND_API_KEY=re_your_resend_api_key_here

# --- アプリのベースURL --------------------------------------------------------
# トラッキングピクセル/リンクの絶対URL生成に使用(末尾スラッシュなし)。
# 例: https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# プロジェクトURL。Supabase Dashboard > Project Settings > Data API。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# 公開 anon キー(ブラウザに露出してよい)。scores の保存/閲覧に使用。
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# サービスロールキー(★サーバー専用・絶対に公開しない)。
# RLSをバイパスし email_* テーブルへフルアクセスする管理APIで使用。
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Basic認証 (管理画面 /admin の保護) --------------------------------------
# proxy.ts が /admin と管理APIを Basic認証で保護する。
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change_me_strong_password

# --- Cron (予約送信) ---------------------------------------------------------
# /api/email/cron を叩く際の共有シークレット(Vercel Cron / 外部スケジューラ用)。
CRON_SECRET=your_random_cron_secret_here

# --- Resend Webhook ----------------------------------------------------------
# Resend からのイベント(開封/バウンス等)Webhookの署名検証シークレット。
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret_here

# --- 配信停止(法令順守) -------------------------------------------------------
# 配信停止リンクのトークン署名に使うシークレット(改ざん防止)。
UNSUBSCRIBE_SECRET=your_unsubscribe_signing_secret_here

# --- 送信者情報(特定電子メール法で必須の表記) -------------------------------
# メールフッターに表示する送信者(会社)情報。
COMPANY_NAME=クロボ株式会社
COMPANY_ADDRESS=〒000-0000 都道府県市区町村番地
COMPANY_CONTACT_EMAIL=contact@example.com

# --- Unsplash (クイズの画像取得) ---------------------------------------------
# 画像クイズで使用する Unsplash の Access Key。https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
